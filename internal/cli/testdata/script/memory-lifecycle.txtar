[!unix] skip '夹具用 sh'

# 三种推导一次看全：证据撑不住、复查到期、反例与被反驳的结论并存。
exec keelrc check
stdout 'keel-exit=1'

# 有证据但对不上当前内容：error，不是提醒。
# 文件说了算、证据撑不住，等于把未验证的经验当项目规则用。
stdout 'memory_status_unsupported'
stdout 'memory_review_due'
stdout 'memory_conflict'

# check 只推导不改写：文件里的 status 一个都没动。
exec sh -c 'grep -h "^status:" .keel/memory/*.md'
stdout 'status: verified'
stdout 'status: candidate'

# 空证据的 verified 在加载期就被挡掉，根本进不了库。
exec sh -c 'cp .keel/memory/M-11111111-2222-4333-8444-555555555555-a.md bad.txt'
exec sh -c 'sed "s/^evidence:.*/evidence: []/" bad.txt > .keel/memory/M-11111111-2222-4333-8444-555555555555-a.md'
exec keelrc check
stdout 'keel-exit=1'
stdout 'frontmatter_invalid'
stdout 'status verified 要求 evidence 非空'

-- .keel/keel.yaml --
