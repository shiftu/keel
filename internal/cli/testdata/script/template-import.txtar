[!exec:git] skip '需要 git'
[!unix] skip '夹具用 sh'

# 模板仓库：一条模板方认为已经 active、还带着证据的规则。
cd $WORK/tmpl
exec git init -q
exec git add -A
exec git commit -qm 'template v1'

cd $WORK
mkdir app
cd app
exec git init -q
exec keel init --from $WORK/tmpl --tools claude --no-hooks
stdout '导入 5 个文件'
stdout '1 条规则落成 candidate'

# 导入面：技能、规则、夹具、配置进来了。
exists .keel/skills/team-style/SKILL.md
exists .keel/rules/R-11111111-1111-4111-8111-111111111111-no-println.md
exists .keel/cases/R-11111111/pass/main.go
exists .keel/cases/R-11111111/fail/main.go

# 决策、记忆、证据一律不导入：它们的 digest 指着源仓库的代码，在这边永远对不上。
! exists .keel/decisions/D-22222222-2222-4222-8222-222222222222-x.md
! exists .keel/memory/M-33333333-3333-4333-8333-333333333333-x.md
! exists .keel/evidence/E-44444444-4444-4444-8444-444444444444.md
# intent.md 是本项目自己要回答的问题，不跟着模板走。
! grep '模板仓库的目标' .keel/intent.md

# 规则被强制降级：模板说 active 不算数。
exec sh -c 'cat .keel/rules/R-11111111*.md'
stdout 'status: candidate'
! stdout 'status: active'
stdout 'evidence: \[\]'
stdout 'verifier_digest: ""'
# from 清空：本地没有这条依据，留个悬空引用只会让 check 满仓库红字。
# 出处不丢——from_template 把 commit 钉死了，去源仓库那一版上就能看到原本的 from。
stdout 'from: null'
! stdout 'from: D-22222222'
stdout 'from_template: .*tmpl@'

# candidate 不执行：模板带来的东西不会因为装了一下就跑起来。
exec keel check
stdout '通过'

# promote 拦得住：没有本地决策做依据。
exec keelrc promote R-11111111
stdout 'keel-exit=[12]'
! stdout 'candidate → active'

# tools 是本机的，其余策略照模板。
exec sh -c 'cat .keel/keel.yaml'
stdout 'default_level: 0'
stdout 'require_trailer: true'
! stdout 'codex'

# 来源钉在一个 commit 上。
exec sh -c 'cat .keel/template.yaml'
stdout 'schema: 1'
stdout 'source: .*tmpl'
stdout 'commit: [0-9a-f]{40}'
stdout 'path: rules/R-11111111'

# 导入过一次就不再走 init --from。
exec keelrc init --from $WORK/tmpl --no-hooks
stdout 'keel-exit=2'
stderr '已经从.*导入过模板'

-- tmpl/.keel/keel.yaml --
version: 1
tools:
  - claude
  - codex
workflow:
  default_level: 0
  auto_promote: false
  actions:
    data.delete: 0
  paths: {}
brief:
  max_bytes: 8192
  max_decisions: 4
  max_notes: 4
gate:
  require_trailer: true
  manifests:
    - go.mod
  watch_top_level_dirs: true
sync:
  commit_outputs: true
  skills_mode: copy
mcp:
  servers: {}
knowledge:
  docs:
    - README.md
  exclude: []
  codemap: false
-- tmpl/.keel/intent.md --
# 模板仓库的目标

这一段不该跟着模板跑到别的仓库去。
-- tmpl/.keel/skills/team-style/SKILL.md --
# 团队风格

模板分发的技能。
-- tmpl/.keel/rules/R-11111111-1111-4111-8111-111111111111-no-println.md --
---
schema: 1
id: R-11111111-1111-4111-8111-111111111111
title: 生产代码不得留 println
status: active
scope:
  - '**/*.go'
severity: error
check:
  argv:
    - scripts/no-println.sh
  timeout_seconds: 30
from: D-22222222-2222-4222-8222-222222222222
from_template: null
verifier_digest: sha256:deadbeef
evidence:
  - E-44444444-4444-4444-8444-444444444444
cases:
  - dir: .keel/cases/R-11111111/pass
    expect: pass
  - dir: .keel/cases/R-11111111/fail
    expect: fail
---

模板方认为这条已经验过了。导入到别的仓库必须重新走一遍。
-- tmpl/.keel/cases/R-11111111/pass/main.go --
package main
-- tmpl/.keel/cases/R-11111111/fail/main.go --
package main // println
-- tmpl/.keel/decisions/D-22222222-2222-4222-8222-222222222222-x.md --
---
schema: 1
id: D-22222222-2222-4222-8222-222222222222
title: 模板仓库自己的决策
status: accepted
date: 2026-01-01
scope:
  - '**'
tags: []
supersedes: null
evidence: []
confidence: proven
---

