[!exec:sh] skip '夹具用 sh 写检查脚本'
[!unix] skip '夹具用 sh'

chmod 0755 scripts/check/always-pass.sh

# 没有依据决策：会拦住所有人的硬规则必须有一条说明「为什么」的决策。
exec keelrc promote R-33333333
stdout 'keel-exit=2'
stderr '没有 from'
exec sh -c 'grep "^status:" .keel/rules/R-33333333*.md'
stdout 'status: candidate'

# 只有 pass 方向：一条永远 exit 0 的检查也能满足，不算对照验证。
exec keelrc promote R-44444444
stdout 'keel-exit=2'
stderr 'cases 缺少 pass 或 fail 方向'
exec sh -c 'ls .keel/evidence 2>/dev/null | wc -l | tr -d " "'
stdout '^0$'

# 两个方向都给了，但 fail 夹具实际跑出来是 pass：候选不能放宽自己的检查。
# 这一次是真跑过的，所以失败证据要留在仓库里。
exec keelrc promote R-55555555
stdout 'keel-exit=1'
stderr '✘ \.keel/cases/x/fail 期望 fail，实际 pass'
stderr '留在 candidate'
exec sh -c 'grep "^status:" .keel/rules/R-55555555*.md'
stdout 'status: candidate'
exec sh -c 'cat .keel/evidence/E-*.md'
stdout 'result: fail'
stdout 'subject: R-55555555-5555-4333-8444-555555555555'
stdout '规则留在 candidate'

# review 会把它重新捞出来。
exec keel review
stdout 'rule_candidate_ready'

-- .keel/keel.yaml --
version: 1
-- scripts/check/always-pass.sh --
#!/bin/sh
exit 0
-- .keel/cases/x/pass/ok.txt --
ok
-- .keel/cases/x/fail/bad.txt --
bad
