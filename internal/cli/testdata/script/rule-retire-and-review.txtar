[!unix] skip '夹具用 sh'

# review 只读，且不执行任何规则——这条规则一跑就会失败，但 review 必须干干净净。
exec keel review
stdout '# keel review'
stdout 'rule_candidate_incomplete'
stdout '规则 3（生效 1，候选 1）'
stdout 'review 不执行任何规则'
! stdout 'rule_failed'
! stdout '这条规则总是失败'

# 到期与冲突分开成段。
stdout '到期复查'
stdout '缓存目录必须在本地盘'

# 撤回要给原因，原因写进正文，历史保留。
exec keelrc retire R-22222222
stdout 'keel-exit=2'
stderr '--reason'

exec keel retire R-22222222 --reason '这条规则误伤了迁移脚本'
stderr 'active → retired'
stderr 'R-33333333 曾被它替代'

exec sh -c 'cat .keel/rules/R-22222222*.md'
stdout 'status: retired'
stdout '## 撤回'
stdout '这条规则误伤了迁移脚本'
stdout '只用来验证撤回'

# retired 的不再执行。
exec keel check
stdout '通过'

# 已经 retired 的不能再撤一次。
exec keelrc retire R-22222222 --reason '再来一次'
stdout 'keel-exit=2'
stderr '已经是 retired'

-- .keel/keel.yaml --
version: 1
-- always-fail.sh --
#!/bin/sh
echo "这条规则总是失败"
exit 1
