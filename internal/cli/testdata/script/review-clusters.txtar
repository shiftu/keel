[!exec:git] skip '需要 git'
[!unix] skip '夹具用 sh'

exec git init -q
exec git add -A
exec git commit -q -m first

# 同 scope 同 tag 的候选记忆聚成一簇，但同源转述只算一条：
# 「同一件事换个说法记三遍」不该变成三份依据。
exec keel review
stdout 'memory_cluster'
stdout '2 条 candidate 记忆落在同一个 scope 和 tag 上'
! stdout '3 条 candidate 记忆'

# 反例指向的结论要先处理冲突。
stdout 'memory_disputed'
stdout '先处理冲突，再谈提炼'

# 关联提交被 revert 过的决策要重新审视。
exec sh -c 'echo x > x.txt'
exec git add x.txt
exec git commit -q -F msg.txt
exec git revert --no-edit HEAD
exec keel review
stdout 'decision_reverted'
stdout '关联的 1 个提交后来被 revert 过'
stdout '别直接删'

exec keel review --json
stdout '"code": "decision_reverted"'
stdout '"schema": 1'

