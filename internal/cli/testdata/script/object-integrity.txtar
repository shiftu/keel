# ID 重复、引用缺失、frontmatter 非法都必须报错。
# canonical ID 永不重编号，所以重复只能靠报错暴露，不能自动改名。

exec keelrc check --json
stdout 'keel-exit=1'
stdout '"code": "id_duplicate"'
stdout '"code": "ref_missing"'
stdout '"code": "frontmatter_invalid"'
stdout '"schema": 1'
stdout '"target": "worktree"'
stdout '"status": "fail"'

